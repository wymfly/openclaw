{
  "id": "email",
  "name": "Email",
  "description": "Bundled IMAP/SMTP email tools for reading messages, downloading attachments, and sending mail.",
  "contracts": {
    "tools": ["email_list", "email_read", "email_download_attachments", "email_send"]
  },
  "uiHints": {
    "defaultAccountId": {
      "label": "Default Account ID",
      "help": "Account id used when a tool call omits accountId."
    },
    "accounts.password": {
      "label": "IMAP Password",
      "help": "Password or SecretRef used for IMAP LOGIN.",
      "sensitive": true
    },
    "accounts.smtp.password": {
      "label": "SMTP Password",
      "help": "Password or SecretRef used for SMTP AUTH. Falls back to the IMAP password when omitted.",
      "sensitive": true
    },
    "accounts.smtp.from": {
      "label": "Default From Address",
      "help": "Envelope/header sender address used by email_send when the tool call omits from."
    },
    "sendPolicy.allowedReadRoots": {
      "label": "Allowed Attachment Read Roots",
      "help": "Absolute paths email_send attachments may be read from. Defaults to the current workspace root."
    },
    "downloadPolicy.allowedWriteRoots": {
      "label": "Allowed Attachment Output Roots",
      "help": "Absolute paths attachments may be written to. Defaults to the current workspace root."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultAccountId": {
        "type": "string"
      },
      "accounts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "host", "user"],
          "properties": {
            "id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "number",
              "minimum": 1,
              "maximum": 65535
            },
            "secure": {
              "type": "boolean"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": ["string", "object"]
            },
            "mailbox": {
              "type": "string"
            },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 65535
                },
                "secure": {
                  "type": "boolean"
                },
                "startTls": {
                  "type": "boolean"
                },
                "user": {
                  "type": "string"
                },
                "password": {
                  "type": ["string", "object"]
                },
                "from": {
                  "type": "string"
                },
                "authMethod": {
                  "type": "string",
                  "enum": ["login", "plain"]
                },
                "tls": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "rejectUnauthorized": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rejectUnauthorized": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "sendPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowedReadRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "downloadPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowedWriteRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
