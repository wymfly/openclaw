# Remote mode runs deck-go as a control plane for an already-running Gateway.
# Copy to a private file, set mode 0600, then point DECK_DOTENV_FILE at it or
# source it before launching deck-go.

# deck-go HTTP listener. Keep loopback unless TLS is configured.
DECK_GO_ADDR=127.0.0.1:19566

# Local deck-go data root. Remote endpoint overrides are persisted to
# deck-state.json under this directory unless DECK_STATE_PATH overrides it.
DECK_GO_DATA_DIR=.local/deck-go-remote/data

# Optional explicit deck-state path.
# DECK_STATE_PATH=.local/deck-go-remote/data/deck-state.json

# Deck operator API token. Placeholder only; replace for real deployments.
DECK_GO_ACCESS_TOKEN=replace-with-dev-deck-token

# Runtime mode is fixed at process start.
RUNTIME_MODE=remote

# Optional first-run defaults. Leave URL/token empty to let the UI first-run
# flow collect the remote Gateway endpoint and persist it to deck-state.json.
RUNTIME_REMOTE_URL=
RUNTIME_REMOTE_TOKEN=
RUNTIME_REMOTE_TLS_VERIFY=true

