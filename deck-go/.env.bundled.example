# Bundled mode runs deck-go and a locally spawned OpenClaw Gateway as one
# operational unit. Copy to a private file, set mode 0600, then point
# DECK_DOTENV_FILE at it or source it before launching deck-go.

# deck-go HTTP listener. Keep loopback unless TLS is configured.
DECK_GO_ADDR=127.0.0.1:19566

# Local deck-go data root. deck-state.json is created here unless
# DECK_STATE_PATH overrides it.
DECK_GO_DATA_DIR=.local/deck-go-bundled/data

# Optional explicit deck-state path.
# DECK_STATE_PATH=.local/deck-go-bundled/data/deck-state.json

# Deck operator API token. Placeholder only; replace for real deployments.
DECK_GO_ACCESS_TOKEN=replace-with-dev-deck-token

# Runtime mode is fixed at process start.
RUNTIME_MODE=bundled

# Command used by deck-go to spawn the local Gateway. For source checkouts,
# run from the repo root so `pnpm openclaw ...` resolves to local code.
RUNTIME_BUNDLED_COMMAND=pnpm
RUNTIME_BUNDLED_ARGS=openclaw gateway run --bind loopback --port 18789
RUNTIME_BUNDLED_WORKDIR=/path/to/openclaw

# Gateway bind address and token passed to the spawned process.
RUNTIME_BUNDLED_BIND_HOST=127.0.0.1
RUNTIME_BUNDLED_BIND_PORT=18789
RUNTIME_BUNDLED_TOKEN=replace-with-dev-gateway-token
RUNTIME_BUNDLED_AUTO_START=true

# Extra environment forwarded to the spawned Gateway.
RUNTIME_BUNDLED_ENV_NO_PROXY=localhost,127.0.0.1,::1
RUNTIME_BUNDLED_ENV_OPENCLAW_STATE_DIR=.local/deck-go-bundled/openclaw-state
