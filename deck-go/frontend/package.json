{
  "name": "deck-go-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:deck-ui-host && tsc -b && vite build",
    "check:deck-ui-host": "node scripts/check-deck-ui-host.mjs",
    "dev": "vite --port 5174",
    "preview": "vite preview --port 4174",
    "test:deck-ui": "node ../../scripts/run-vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest-axe": "^0.1.0"
  }
}
