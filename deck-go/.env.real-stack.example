# Real-Gateway full-stack dev/E2E env sample.
# Copy to a private file:
#   cp .env.real-stack.example .env.real-stack && chmod 0600 .env.real-stack
# Then launch with:
#   DECK_GO_REAL_STACK_ENV=$(pwd)/.env.real-stack scripts/dev/run-stack-real.sh start

# === deck-go backend ===
DECK_GO_ADDR=127.0.0.1:19566
DECK_GO_DATA_DIR=.local/deck-go-real-stack/isolated/data
DECK_GO_ACCESS_TOKEN=replace-with-dev-deck-token

# === Vite dev server / preview ===
DECK_GO_FRONTEND_HOST=127.0.0.1
DECK_GO_FRONTEND_PORT=4174
# dev = Vite HMR server for visual debugging; preview = built output smoke.
DECK_GO_FRONTEND_MODE=dev
VITE_DECK_GO_API_BASE=http://127.0.0.1:19566
VITE_DECK_VISUAL_STATE=1
# VITE_DECK_GO_AUTO_UNLOCK=0

# === Runtime mode = local (real Gateway service) ===
RUNTIME_MODE=local

# Optional: non-standard OpenClaw checkout root. The launcher defaults this to
# deck-go's parent directory.
# OPENCLAW_REPO_ROOT=/path/to/openclaw

# Canonical full Gateway state for manual real-stack runs. Keep long-lived
# agents, providers, sessions, and workspaces here. Automated real E2E specs use
# this config as a seed and run against temp copies.
OPENCLAW_STATE_DIR=.local/deck-go-real-stack/isolated/data/managed-gateway-state
