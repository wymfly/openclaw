# Real-Gateway全栈 dev/E2E env 样例。
# 与 .env.bundled.example 的区别：
# 1. 包含前端 Vite preview / dev server 相关变量；
# 2. 端口与 OpenClaw state 全部走"真实环境"——不隔离、不 mock。
# 复制为私有文件（`cp .env.real-stack.example .env.real-stack && chmod 0600 .env.real-stack`），
# 然后用 `DECK_GO_STACK_ENV=$(pwd)/.env.real-stack scripts/dev/run-stack-real.sh start` 启动。

# === deck-go backend ===
DECK_GO_ADDR=127.0.0.1:19566
DECK_GO_DATA_DIR=.local/deck-go-real-stack/data
# 给前端用同一个 token，方便 curl/Playwright 直接调 API。
DECK_GO_ACCESS_TOKEN=replace-with-dev-deck-token

# === Vite preview / dev server ===
DECK_GO_FRONTEND_HOST=127.0.0.1
DECK_GO_FRONTEND_PORT=4174
VITE_DECK_GO_API_BASE=http://127.0.0.1:19566
VITE_DECK_VISUAL_STATE=1

# === Runtime mode = bundled (真 Gateway) ===
RUNTIME_MODE=bundled

# 真 OpenClaw Gateway 启动命令——必须从仓库根跑，使用本地源码版本。
# WORKDIR 自动取 deck-go 的父目录（仓库根），无需手填。
RUNTIME_BUNDLED_COMMAND=pnpm
# --allow-unconfigured：跳过 OpenClaw 强制 config 校验（dev/E2E 用）。
# 生产部署应通过 RUNTIME_BUNDLED_ENV_OPENCLAW_HOME 指向已配置的 state dir。
RUNTIME_BUNDLED_ARGS="openclaw gateway run --bind loopback --port 18789 --allow-unconfigured"

# Gateway 监听地址（与 ARGS 中的 port 保持一致）。
RUNTIME_BUNDLED_BIND_HOST=127.0.0.1
RUNTIME_BUNDLED_BIND_PORT=18789
RUNTIME_BUNDLED_TOKEN=replace-with-dev-gateway-token
RUNTIME_BUNDLED_AUTO_START=true

# 透传给 Gateway 的环境变量。OPENCLAW_STATE_DIR 不设 = 使用默认 ~/.openclaw
# （用户真实状态，便于跑真 LLM、真 channel）。如需隔离自行覆盖。
RUNTIME_BUNDLED_ENV_NO_PROXY=localhost,127.0.0.1,::1
