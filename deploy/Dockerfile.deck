# ------------------------------------------------------------------
# openclaw-deck — Multi-stage Dockerfile (Next.js standalone)
#
# Build context: repository root (not dashboard/)
#   docker build -f deploy/Dockerfile.deck -t openclaw-deck .
#
# Runtime env vars:
#   DECK_DB_PATH       — SQLite database path (default: /data/deck.db)
#   GATEWAY_URL        — OpenClaw gateway URL
#   DECK_AUTH_SECRET   — Session auth secret
# ------------------------------------------------------------------

# ======================== build stage ========================
FROM node:22-bookworm AS builder

RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

WORKDIR /app

# -- Layer 1: workspace manifests (cache-friendly) ----------------
# Copy only package.json files + lockfile + workspace config.
# Docker does not support recursive globs, so we list them explicitly.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY dashboard/package.json dashboard/
COPY ui/package.json ui/

# Workspace members: extensions/*/package.json and packages/*/package.json.
# We mount them read-only and copy just the manifests to satisfy the lockfile.
RUN --mount=type=bind,source=extensions,target=/tmp/extensions \
    --mount=type=bind,source=packages,target=/tmp/packages \
    for dir in /tmp/extensions/*/; do \
      name=$(basename "$dir"); \
      mkdir -p "extensions/$name"; \
      cp "$dir/package.json" "extensions/$name/package.json"; \
    done && \
    for dir in /tmp/packages/*/; do \
      name=$(basename "$dir"); \
      mkdir -p "packages/$name"; \
      cp "$dir/package.json" "packages/$name/package.json"; \
    done

# -- Layer 2: install dependencies --------------------------------
# better-sqlite3 is not in pnpm-workspace.yaml's onlyBuiltDependencies
# (to avoid building it in CI where it's unused). We add it before install.
RUN sed -i '/onlyBuiltDependencies:/a\  - better-sqlite3' pnpm-workspace.yaml && \
    pnpm install --frozen-lockfile --filter openclaw-deck...

# Compile better-sqlite3 native addon for Linux.
# pnpm rebuild doesn't always trigger for hoisted deps, so we run
# the install script directly inside the package directory.
RUN cd node_modules/better-sqlite3 && \
    npx --yes prebuild-install || npx --yes node-gyp rebuild --release

# -- Layer 3: dashboard source + build ----------------------------
COPY dashboard/ ./dashboard/

ENV NEXT_TELEMETRY_DISABLED=1
# Use webpack mode (--no-turbopack) because Turbopack's Google Fonts
# integration requires network access at build time, which may not
# be available in restricted Docker build environments.
RUN cd dashboard && npx next build --webpack

# ======================== runtime stage ========================
FROM node:22-bookworm-slim AS runtime

# No apt-get install needed — healthcheck uses Node.js (see below).

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DECK_DB_PATH=/data/deck.db
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Copy standalone server output.
# Next.js standalone mirrors the workspace directory structure:
#   .next/standalone/
#     node_modules/     ← traced root deps (better-sqlite3, ws, etc.)
#     dashboard/
#       server.js       ← entry point
#       .next/          ← server chunks
#       package.json
COPY --from=builder /app/dashboard/.next/standalone ./

# Copy static assets (CSS/JS bundles generated by Next.js)
COPY --from=builder /app/dashboard/.next/static ./dashboard/.next/static

# Copy migrations — db.ts resolves "../migrations" relative to
# the bundled server code path, which maps to dashboard/migrations
# in the standalone output directory structure.
COPY --from=builder /app/dashboard/migrations ./dashboard/migrations

# better-sqlite3 native addon — Next.js standalone file tracing does not
# follow the dynamic binary resolution done by the `bindings` package.
# Copy the Linux-compiled native addon from the builder's node_modules.
COPY --from=builder /app/node_modules/better-sqlite3/build \
  ./node_modules/better-sqlite3/build

# Create data volume mount point
RUN mkdir -p /data && chown node:node /data

VOLUME /data

USER node

EXPOSE 3000

# Healthcheck using Node.js (avoids installing curl/wget in slim image)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/').then(r=>{process.exit(r.ok?0:1)}).catch(()=>process.exit(1))"

CMD ["node", "dashboard/server.js"]
