# ============================================================
# OpenClaw + Deck 部署环境变量
# install.sh 会自动从此文件创建 .env（无需手动复制）
# ============================================================

# === AI Provider API Keys ===
# CPA（内部 OpenAI 兼容 API，已预填）
CPA_API_KEY=team-member3-key-g7h8i9
CPA_BASE_URL=http://47.103.199.212:8317/v1

# 标准 providers（按需填写）
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Gateway 认证令牌（已预填，所有实例共用） ===
OPENCLAW_GATEWAY_TOKEN=aca39b9b08d8d8a18012b66286a4cb19e3bdab40844d74e59b29cf49957c9436

# === 可选 ===
# 默认模型（provider/model-id 格式）
DEFAULT_MODEL=cpa/gpt-5.4

# Moonshot / Kimi
MOONSHOT_API_KEY=

# 端口
GATEWAY_PORT=18789
DECK_PORT=3000

# 时区
TZ=Asia/Shanghai

# OpenClaw 数据目录（单一挂载点，包含配置、workspace、agents、日志等全部运行时状态）
# Docker 模式：挂载到容器的 /home/node/.openclaw/
# 裸机模式：OPENCLAW_HOME = 父目录，Gateway 读取 $OPENCLAW_HOME/.openclaw/openclaw.json
# 两种模式共享同一目录，目录名必须以 .openclaw 结尾
OPENCLAW_STATE_DIR=./data/.openclaw

# Deck 数据目录（JSON 文件持久化，与 Gateway 状态分离）
DECK_DATA_DIR=./data/openclaw-deck

# Sandbox（设为 1 启用 agent 执行隔离）
OPENCLAW_SANDBOX=
# Docker socket group ID（sandbox 需要，运行: stat -c '%g' /var/run/docker.sock）
DOCKER_GID=999

# 频道 Token（按需填写）
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# === 性能调优 ===
# 插件发现缓存（毫秒）。默认 1000（开发模式）。
# 生产部署建议 300000（5 分钟），避免每次 RPC 调用重复扫描 extensions 目录。
OPENCLAW_PLUGIN_DISCOVERY_CACHE_MS=300000

# 额外的 apt 包（Docker 模式，空格分隔）
OPENCLAW_DOCKER_APT_PACKAGES="python3 python3-pip ripgrep jq wget"
