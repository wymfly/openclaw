# ============================================================
# OpenClaw + Deck 部署环境变量
# 复制为 .env 后编辑
# ============================================================

# === 必填：AI Provider API Keys（至少配一个） ===
# CPA（自定义 OpenAI 兼容 API）
CPA_API_KEY=
CPA_BASE_URL=

# 标准 providers
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === 自动生成（setup.sh 会填充，也可手动指定） ===
OPENCLAW_GATEWAY_TOKEN=

# === 可选 ===
# 默认模型（provider/model-id 格式）
DEFAULT_MODEL=deepseek/deepseek-chat

# Moonshot / Kimi
MOONSHOT_API_KEY=

# 端口
GATEWAY_PORT=18789
DECK_PORT=3000

# 时区
TZ=Asia/Shanghai

# OpenClaw 数据目录（单一挂载点，包含配置、workspace、agents、日志等全部运行时状态）
# Docker 模式：挂载到容器的 /home/node/.openclaw/
# 裸机模式：OPENCLAW_HOME = 父目录，Gateway 读取 $OPENCLAW_HOME/.openclaw/openclaw.json
# 两种模式共享同一目录，目录名必须以 .openclaw 结尾
OPENCLAW_STATE_DIR=./data/.openclaw

# Deck 数据库目录（SQLite，与 Gateway 状态分离）
DECK_DATA_DIR=./data/openclaw-deck

# Sandbox（设为 1 启用 agent 执行隔离）
OPENCLAW_SANDBOX=
# Docker socket group ID（sandbox 需要，运行: stat -c '%g' /var/run/docker.sock）
DOCKER_GID=999

# 频道 Token（按需填写）
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# 额外的 apt 包（Docker 模式，空格分隔）
OPENCLAW_DOCKER_APT_PACKAGES="python3 python3-pip ripgrep jq wget"
